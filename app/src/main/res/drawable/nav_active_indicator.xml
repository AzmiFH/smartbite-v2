<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Glow effect around icon area -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/nav_glow_green" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Indicator line at bottom of the icon area -->
    <item android:top="28dp" android:bottom="-4dp" android:left="16dp" android:right="16dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/nav_active_green" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>