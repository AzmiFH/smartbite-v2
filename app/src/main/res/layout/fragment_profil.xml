<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/profile_header_bg"
    android:fillViewport="true"
    tools:context=".ui.profil.ProfilFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/tv_profile_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:text="@string/profile_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Profile Header Section -->
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/profile_image"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="24dp"
            android:src="@drawable/th"
            app:civ_border_color="@color/white"
            app:civ_border_width="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_profile_title" />

        <ImageView
            android:id="@+id/iv_edit_profile"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/ic_back_circle"
            android:backgroundTint="@color/white"
            android:elevation="4dp"
            android:padding="6dp"
            android:src="@drawable/ic_edit_pen"
            app:layout_constraintBottom_toBottomOf="@id/profile_image"
            app:layout_constraintEnd_toEndOf="@id/profile_image"
            app:tint="@color/brand_green" />

        <TextView
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/profile_image"
            tools:text="Sarah Hidayat" />

        <TextView
            android:id="@+id/tv_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_name"
            tools:text="sarah.hidayat@email.com" />

        <LinearLayout
            android:id="@+id/ly_goal_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_badge_goal"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_email">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_macro_fiber"
                app:tint="@color/badge_goal_text" />

            <TextView
                android:id="@+id/tv_goal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Weight Loss Focus"
                android:textColor="@color/badge_goal_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Metrics Grid -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_metrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:paddingHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@id/ly_goal_badge">

            <!-- Gender Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/card_gender"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_metric_card"
                android:padding="16dp"
                app:layout_constraintEnd_toStartOf="@+id/card_age"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/iv_gender_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/male_and_female_ic"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/icon_metric_gray" />

                <TextView
                    android:id="@+id/tv_gender_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/gender"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="@id/iv_gender_icon"
                    app:layout_constraintStart_toEndOf="@id/iv_gender_icon"
                    app:layout_constraintTop_toTopOf="@id/iv_gender_icon" />

                <TextView
                    android:id="@+id/tv_gender_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/iv_gender_icon"
                    tools:text="Female" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Age Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/card_age"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_metric_card"
                android:padding="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/card_gender"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/iv_age_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_age"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/icon_metric_gray" />

                <TextView
                    android:id="@+id/tv_age_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/age"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="@id/iv_age_icon"
                    app:layout_constraintStart_toEndOf="@id/iv_age_icon"
                    app:layout_constraintTop_toTopOf="@id/iv_age_icon" />

                <TextView
                    android:id="@+id/tv_age_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/iv_age_icon"
                    tools:text="28 Years" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Weight Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/card_weight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_metric_card"
                android:padding="16dp"
                app:layout_constraintEnd_toStartOf="@+id/card_height"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/card_gender">

                <ImageView
                    android:id="@+id/iv_weight_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/weight"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/icon_metric_gray" />

                <TextView
                    android:id="@+id/tv_weight_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/weight"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="@id/iv_weight_icon"
                    app:layout_constraintStart_toEndOf="@id/iv_weight_icon"
                    app:layout_constraintTop_toTopOf="@id/iv_weight_icon" />

                <TextView
                    android:id="@+id/tv_weight_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/iv_weight_icon"
                    tools:text="64 kg" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Height Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/card_height"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_metric_card"
                android:padding="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/card_weight"
                app:layout_constraintTop_toBottomOf="@id/card_age">

                <ImageView
                    android:id="@+id/iv_height_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_height"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/icon_metric_gray" />

                <TextView
                    android:id="@+id/tv_height_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/height"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="@id/iv_height_icon"
                    app:layout_constraintStart_toEndOf="@id/iv_height_icon"
                    app:layout_constraintTop_toTopOf="@id/iv_height_icon" />

                <TextView
                    android:id="@+id/tv_height_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/iv_height_icon"
                    tools:text="165 cm" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- BMI Status Section -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/card_bmi_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_metric_card"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/cl_metrics">

            <View
                android:id="@+id/v_bmi_icon_bg"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_circle_green"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <ImageView
                android:id="@+id/iv_bmi_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_macro_fiber"
                app:layout_constraintBottom_toBottomOf="@id/v_bmi_icon_bg"
                app:layout_constraintEnd_toEndOf="@id/v_bmi_icon_bg"
                app:layout_constraintStart_toStartOf="@id/v_bmi_icon_bg"
                app:layout_constraintTop_toTopOf="@id/v_bmi_icon_bg"
                app:tint="@color/brand_green" />

            <TextView
                android:id="@+id/tv_bmi_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Status BMI"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                app:layout_constraintStart_toEndOf="@id/v_bmi_icon_bg"
                app:layout_constraintTop_toTopOf="@id/v_bmi_icon_bg" />

            <TextView
                android:id="@+id/tv_bmi_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@id/tv_bmi_label"
                app:layout_constraintTop_toBottomOf="@id/tv_bmi_label"
                tools:text="22.5 (Normal)" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Nutrition Strategy Section -->
        <TextView
            android:id="@+id/tv_nutrition_strategy_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:text="@string/nutrition_strategy_title"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_bmi_status" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/card_nutrition_strategy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_metric_card"
            android:padding="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_nutrition_strategy_label">

            <View
                android:id="@+id/v_sync_icon_bg"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_circle_green"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_sync_metrics"
                app:layout_constraintBottom_toBottomOf="@id/v_sync_icon_bg"
                app:layout_constraintEnd_toEndOf="@id/v_sync_icon_bg"
                app:layout_constraintStart_toStartOf="@id/v_sync_icon_bg"
                app:layout_constraintTop_toTopOf="@id/v_sync_icon_bg"
                app:tint="@color/badge_goal_text" />

            <TextView
                android:id="@+id/tv_update_metrics_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="8dp"
                android:text="@string/update_metrics_title"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@+id/iv_chevron_nutrition"
                app:layout_constraintStart_toEndOf="@id/v_sync_icon_bg"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_update_metrics_desc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/update_metrics_desc"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="@id/tv_update_metrics_title"
                app:layout_constraintStart_toStartOf="@id/tv_update_metrics_title"
                app:layout_constraintTop_toBottomOf="@id/tv_update_metrics_title" />

            <ImageView
                android:id="@+id/iv_chevron_nutrition"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_right"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/icon_metric_gray" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Preferences Section -->
        <TextView
            android:id="@+id/tv_preferences_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="32dp"
            android:text="@string/preferences_title"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_nutrition_strategy" />

        <androidx.cardview.widget.CardView
            android:id="@+id/card_preferences"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_preferences_label">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_metric_card"
                android:orientation="vertical"
                android:padding="8dp">

                <!-- Smart Notifications -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/item_notifications"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp">

                    <View
                        android:id="@+id/v_notif_bg"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_icon_circle_green"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/iv_notif_icon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_notifications_black_24dp"
                        app:layout_constraintBottom_toBottomOf="@id/v_notif_bg"
                        app:layout_constraintEnd_toEndOf="@id/v_notif_bg"
                        app:layout_constraintStart_toStartOf="@id/v_notif_bg"
                        app:layout_constraintTop_toTopOf="@id/v_notif_bg"
                        app:tint="@color/badge_goal_text" />

                    <TextView
                        android:id="@+id/tv_notif_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/smart_notifications"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@+id/switch_notifications"
                        app:layout_constraintStart_toEndOf="@id/v_notif_bg"
                        app:layout_constraintTop_toTopOf="parent" />


                    <TextView
                        android:id="@+id/tv_notif_desc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/smart_notifications_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="@id/tv_notif_title"
                        app:layout_constraintStart_toStartOf="@id/tv_notif_title"
                        app:layout_constraintTop_toBottomOf="@id/tv_notif_title" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_notifications"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:thumbTint="@color/brand_green"
                        app:trackTint="@color/badge_goal_bg" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="48dp"
                    android:background="#F0F0F0" />

                <!-- Language -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/item_language"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp">

                    <View
                        android:id="@+id/v_lang_bg"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_icon_circle_green"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_language"
                        app:layout_constraintBottom_toBottomOf="@id/v_lang_bg"
                        app:layout_constraintEnd_toEndOf="@id/v_lang_bg"
                        app:layout_constraintStart_toStartOf="@id/v_lang_bg"
                        app:layout_constraintTop_toTopOf="@id/v_lang_bg"
                        app:tint="@color/badge_goal_text" />

                    <TextView
                        android:id="@+id/tv_lang_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/language"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@+id/iv_chevron_lang"
                        app:layout_constraintStart_toEndOf="@id/v_lang_bg"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_lang_desc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/language_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="@id/tv_lang_title"
                        app:layout_constraintStart_toStartOf="@id/tv_lang_title"
                        app:layout_constraintTop_toBottomOf="@id/tv_lang_title" />

                    <ImageView
                        android:id="@+id/iv_chevron_lang"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/icon_metric_gray" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="48dp"
                    android:background="#F0F0F0" />

                <!-- Help Center -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/item_help"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp">

                    <View
                        android:id="@+id/v_help_bg"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_icon_circle_green"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_help"
                        app:layout_constraintBottom_toBottomOf="@id/v_help_bg"
                        app:layout_constraintEnd_toEndOf="@id/v_help_bg"
                        app:layout_constraintStart_toStartOf="@id/v_help_bg"
                        app:layout_constraintTop_toTopOf="@id/v_help_bg"
                        app:tint="@color/badge_goal_text" />

                    <TextView
                        android:id="@+id/tv_help_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/help_center"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@+id/iv_chevron_help"
                        app:layout_constraintStart_toEndOf="@id/v_help_bg"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_help_desc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/help_center_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="@id/tv_help_title"
                        app:layout_constraintStart_toStartOf="@id/tv_help_title"
                        app:layout_constraintTop_toBottomOf="@id/tv_help_title" />

                    <ImageView
                        android:id="@+id/iv_chevron_help"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/icon_metric_gray" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="48dp"
                    android:background="#F0F0F0" />

                <!-- Delete Account -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/item_delete_account"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp">

                    <View
                        android:id="@+id/v_delete_bg"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_icon_circle_green"
                        android:backgroundTint="#FFEBEE"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_delete"
                        app:layout_constraintBottom_toBottomOf="@id/v_delete_bg"
                        app:layout_constraintEnd_toEndOf="@id/v_delete_bg"
                        app:layout_constraintStart_toStartOf="@id/v_delete_bg"
                        app:layout_constraintTop_toTopOf="@id/v_delete_bg"
                        app:tint="#F44336" />

                    <TextView
                        android:id="@+id/tv_delete_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/delete_account"
                        android:textColor="#F44336"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@+id/iv_chevron_delete"
                        app:layout_constraintStart_toEndOf="@id/v_delete_bg"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_delete_desc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/delete_account_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="@id/tv_delete_title"
                        app:layout_constraintStart_toStartOf="@id/tv_delete_title"
                        app:layout_constraintTop_toBottomOf="@id/tv_delete_title" />

                    <ImageView
                        android:id="@+id/iv_chevron_delete"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/icon_metric_gray" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Redesigned Logout Button -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/logout_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_logout_button"
            android:clickable="true"
            android:focusable="true"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@+id/card_preferences">

            <ImageView
                android:id="@+id/iv_logout_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_logout"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/tv_logout_text"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_logout_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/sign_out"
                android:textColor="#F44336"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/iv_logout_icon"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
