<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FD"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/onboarding_goal_title"
        android:textColor="#1A1C1E"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="4sp"
        android:text="@string/onboarding_goal_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/tv_title" />

    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        android:scrollbars="none"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/btn_next"
        app:layout_constraintTop_toBottomOf="@id/tv_subtitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="100dp"
            android:orientation="vertical">

            <!-- Maintain Weight -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btn_maintain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_goal_card_unselected"
                android:clickable="true"
                android:focusable="true"
                android:padding="16dp">

                <View
                    android:id="@+id/v_icon_bg_maintain"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_goal_icon_unselected"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/iv_icon_maintain"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_maintain"
                    app:layout_constraintBottom_toBottomOf="@id/v_icon_bg_maintain"
                    app:layout_constraintEnd_toEndOf="@id/v_icon_bg_maintain"
                    app:layout_constraintStart_toStartOf="@id/v_icon_bg_maintain"
                    app:layout_constraintTop_toTopOf="@id/v_icon_bg_maintain"
                    app:tint="@color/brand_green" />

                <TextView
                    android:id="@+id/tv_maintain_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="8dp"
                    android:text="@string/goal_maintain_weight"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@+id/iv_check_maintain"
                    app:layout_constraintStart_toEndOf="@id/v_icon_bg_maintain"
                    app:layout_constraintTop_toTopOf="@id/v_icon_bg_maintain" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/goal_maintain_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toEndOf="@id/tv_maintain_title"
                    app:layout_constraintStart_toStartOf="@id/tv_maintain_title"
                    app:layout_constraintTop_toBottomOf="@id/tv_maintain_title" />

                <ImageView
                    android:id="@+id/iv_check_maintain"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_check_circle_outline"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/v_icon_bg_maintain"
                    app:tint="#D1D5DB" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Lose Weight -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btn_lose_weight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_goal_card_unselected"
                android:clickable="true"
                android:focusable="true"
                android:padding="16dp">

                <View
                    android:id="@+id/v_icon_bg_lose"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_goal_icon_unselected"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/iv_icon_lose"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_lose_weight"
                    app:layout_constraintBottom_toBottomOf="@id/v_icon_bg_lose"
                    app:layout_constraintEnd_toEndOf="@id/v_icon_bg_lose"
                    app:layout_constraintStart_toStartOf="@id/v_icon_bg_lose"
                    app:layout_constraintTop_toTopOf="@id/v_icon_bg_lose"
                    app:tint="@color/brand_green" />

                <TextView
                    android:id="@+id/tv_lose_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="8dp"
                    android:text="@string/goal_weight_loss"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@+id/iv_check_lose"
                    app:layout_constraintStart_toEndOf="@id/v_icon_bg_lose"
                    app:layout_constraintTop_toTopOf="@id/v_icon_bg_lose" />

                <TextView
                    android:id="@+id/tv_lose_desc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/goal_loss_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toEndOf="@id/tv_lose_title"
                    app:layout_constraintStart_toStartOf="@id/tv_lose_title"
                    app:layout_constraintTop_toBottomOf="@id/tv_lose_title" />

                <ImageView
                    android:id="@+id/iv_check_lose"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_check_circle_outline"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/v_icon_bg_lose"
                    app:tint="#D1D5DB" />

                <!-- Expanded Input for Lose Weight -->
                <LinearLayout
                    android:id="@+id/ll_target_weight_lose"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/tv_lose_title"
                    app:layout_constraintTop_toBottomOf="@id/tv_lose_desc">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/goal_target_weight"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/edittext_background"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">

                        <EditText
                            android:id="@+id/edt_target_weight_lose"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="0"
                            android:inputType="number"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="kg"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_goal_info_lose"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/brand_green"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="Recommendation: 0 - 0 kg" />

                    <TextView
                        android:id="@+id/tv_safety_warning_lose"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/target_weight_warning"
                        android:textColor="#F44336"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Gain Muscle -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btn_gain_muscle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_goal_card_unselected"
                android:clickable="true"
                android:focusable="true"
                android:padding="16dp">

                <View
                    android:id="@+id/v_icon_bg_gain"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_goal_icon_unselected"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/iv_icon_gain"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_gain_muscle"
                    app:layout_constraintBottom_toBottomOf="@id/v_icon_bg_gain"
                    app:layout_constraintEnd_toEndOf="@id/v_icon_bg_gain"
                    app:layout_constraintStart_toStartOf="@id/v_icon_bg_gain"
                    app:layout_constraintTop_toTopOf="@id/v_icon_bg_gain"
                    app:tint="@color/brand_green" />

                <TextView
                    android:id="@+id/tv_gain_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="8dp"
                    android:text="@string/goal_muscle_building"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@+id/iv_check_gain"
                    app:layout_constraintStart_toEndOf="@id/v_icon_bg_gain"
                    app:layout_constraintTop_toTopOf="@id/v_icon_bg_gain" />

                <TextView
                    android:id="@+id/tv_gain_desc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/goal_gain_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toEndOf="@id/tv_gain_title"
                    app:layout_constraintStart_toStartOf="@id/tv_gain_title"
                    app:layout_constraintTop_toBottomOf="@id/tv_gain_title" />

                <ImageView
                    android:id="@+id/iv_check_gain"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_check_circle_outline"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/v_icon_bg_gain"
                    app:tint="#D1D5DB" />

                <!-- Expanded Input for Gain Muscle -->
                <LinearLayout
                    android:id="@+id/ll_target_weight_gain"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/tv_gain_title"
                    app:layout_constraintTop_toBottomOf="@id/tv_gain_desc">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/goal_target_weight"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/edittext_background"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">

                        <EditText
                            android:id="@+id/edt_target_weight_gain"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="0"
                            android:inputType="number"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="kg"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_goal_info_gain"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/brand_green"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="Recommendation: 0 - 0 kg" />

                    <TextView
                        android:id="@+id/tv_safety_warning_gain"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/target_weight_warning"
                        android:textColor="#F44336"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>
    </ScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btn_next"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/onboarding_button_bg"
        android:alpha="0.5"
        android:clickable="false"
        android:focusable="false"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_next"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>