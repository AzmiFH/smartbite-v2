<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <!-- Header: Month Navigator -->
        <LinearLayout
            android:id="@+id/ll_month_navigator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/iv_prev_week"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:src="@drawable/ic_chevron_left"
                app:tint="#CCCCCC" />

            <TextView
                android:id="@+id/tv_current_month_range"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="32dp"
                android:text="Jun 14 - Jun 20"
                android:textColor="@color/text_black_bold"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/iv_next_week"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="#CCCCCC" />
        </LinearLayout>

        <!-- Weekly Calendar -->
        <LinearLayout
            android:id="@+id/ll_weekly_calendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="8dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/ll_month_navigator">

            <include layout="@layout/item_calendar_day" android:id="@+id/day_1" />
            <include layout="@layout/item_calendar_day" android:id="@+id/day_2" />
            <include layout="@layout/item_calendar_day" android:id="@+id/day_3" />
            <include layout="@layout/item_calendar_day" android:id="@+id/day_4" />
            <include layout="@layout/item_calendar_day" android:id="@+id/day_5" />
            <include layout="@layout/item_calendar_day" android:id="@+id/day_6" />
            <include layout="@layout/item_calendar_day" android:id="@+id/day_7" />

        </LinearLayout>

        <!-- Main Content Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cv_main_report"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginHorizontal="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/white"
            app:layout_constraintTop_toBottomOf="@id/ll_weekly_calendar">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <!-- Activity Rings Section -->
                <FrameLayout
                    android:id="@+id/fl_activity_rings"
                    android:layout_width="230dp"
                    android:layout_height="230dp"
                    android:layout_marginTop="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <!-- Outer Ring (Orange/Red - Protein) -->
                    <!-- Track Arc -->
                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:progress="94"
                        android:rotation="-79"
                        app:indicatorColor="@color/ring_bg_orange"
                        app:indicatorSize="220dp"
                        app:trackColor="@android:color/transparent"
                        app:trackThickness="14dp"
                        app:trackCornerRadius="7dp" />
                    <!-- Progress Arc -->
                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/cp_ring_outer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:progress="75"
                        android:rotation="-79"
                        app:indicatorColor="@color/ring_orange"
                        app:indicatorSize="220dp"
                        app:trackColor="@android:color/transparent"
                        app:trackThickness="14dp"
                        app:trackCornerRadius="7dp" />

                    <!-- Middle Ring (Green - Carbs) -->
                    <!-- Track Arc -->
                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:progress="94"
                        android:rotation="-79"
                        app:indicatorColor="@color/ring_bg_green"
                        app:indicatorSize="178dp"
                        app:trackColor="@android:color/transparent"
                        app:trackThickness="14dp"
                        app:trackCornerRadius="7dp" />
                    <!-- Progress Arc -->
                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/cp_ring_middle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:progress="60"
                        android:rotation="-79"
                        app:indicatorColor="@color/ring_green"
                        app:indicatorSize="178dp"
                        app:trackColor="@android:color/transparent"
                        app:trackThickness="14dp"
                        app:trackCornerRadius="7dp" />

                    <!-- Inner Ring (Blue - Fat) -->
                    <!-- Track Arc -->
                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:progress="94"
                        android:rotation="-79"
                        app:indicatorColor="@color/ring_bg_blue"
                        app:indicatorSize="136dp"
                        app:trackColor="@android:color/transparent"
                        app:trackThickness="14dp"
                        app:trackCornerRadius="7dp" />
                    <!-- Progress Arc -->
                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/cp_ring_inner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:progress="45"
                        android:rotation="-79"
                        app:indicatorColor="@color/ring_blue"
                        app:indicatorSize="136dp"
                        app:trackColor="@android:color/transparent"
                        app:trackThickness="14dp"
                        app:trackCornerRadius="7dp" />

                    <!-- Icons: Aligned with Dashboard -->
                    <!-- Protein (Orange/Red) - Fork/Knife -->
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="5dp"
                        android:src="@drawable/ic_food_fork_knife"
                        android:translationZ="10dp"
                        app:tint="@color/ring_orange" />

                    <!-- Carbs (Green) - Apple -->
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="26dp"
                        android:src="@drawable/ic_fruit_apple"
                        android:translationZ="10dp"
                        app:tint="@color/ring_green" />

                    <!-- Fat (Blue) - Avocado -->
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="47dp"
                        android:src="@drawable/ic_fruit_avocado"
                        android:translationZ="10dp"
                        app:tint="@color/ring_blue" />

                    <!-- Center Text -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_consumed_cal_big"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1500"
                            android:textColor="@color/text_black_bold"
                            android:textSize="32sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_target_cal_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="/ 2000 kcal"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Macros Grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toBottomOf="@id/fl_activity_rings">

                    <!-- Carbs (Green) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="90dp"
                            android:layout_height="90dp">

                            <!-- Track Arc -->
                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:progress="94"
                                android:rotation="-79"
                                app:indicatorColor="@color/ring_bg_green"
                                app:indicatorSize="86dp"
                                app:trackColor="@android:color/transparent"
                                app:trackThickness="10dp"
                                app:trackCornerRadius="5dp" />
                            <!-- Progress Arc -->
                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/pb_laporan_carbs"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:progress="80"
                                android:rotation="-79"
                                app:indicatorColor="@color/ring_green"
                                app:indicatorSize="86dp"
                                app:trackColor="@android:color/transparent"
                                app:trackThickness="10dp"
                                app:trackCornerRadius="5dp" />

                            <!-- Small Icon at top -->
                            <ImageView
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_gravity="top|center_horizontal"
                                android:layout_marginTop="2dp"
                                android:src="@drawable/ic_fruit_apple"
                                android:translationZ="10dp"
                                app:tint="@color/ring_green" />

                        </FrameLayout>

                        <TextView
                            android:id="@+id/tv_carb_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="-64dp"
                            android:text="95"
                            android:textColor="@color/text_black_bold"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_carb_target"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="/ 120g"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Protein (Orange/Red) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="90dp"
                            android:layout_height="90dp">

                            <!-- Track Arc -->
                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:progress="94"
                                android:rotation="-79"
                                app:indicatorColor="@color/ring_bg_orange"
                                app:indicatorSize="86dp"
                                app:trackColor="@android:color/transparent"
                                app:trackThickness="10dp"
                                app:trackCornerRadius="5dp" />
                            <!-- Progress Arc -->
                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/pb_laporan_protein"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:progress="80"
                                android:rotation="-79"
                                app:indicatorColor="@color/ring_orange"
                                app:indicatorSize="86dp"
                                app:trackColor="@android:color/transparent"
                                app:trackThickness="10dp"
                                app:trackCornerRadius="5dp" />

                            <!-- Small Icon at top -->
                            <ImageView
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_gravity="top|center_horizontal"
                                android:layout_marginTop="2dp"
                                android:src="@drawable/ic_food_fork_knife"
                                android:translationZ="10dp"
                                app:tint="@color/ring_orange" />

                        </FrameLayout>

                        <TextView
                            android:id="@+id/tv_protein_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="-64dp"
                            android:text="200"
                            android:textColor="@color/text_black_bold"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_protein_target"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="/ 250g"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Fat (Blue) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="90dp"
                            android:layout_height="90dp">

                            <!-- Track Arc -->
                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:progress="94"
                                android:rotation="-79"
                                app:indicatorColor="@color/ring_bg_blue"
                                app:indicatorSize="86dp"
                                app:trackColor="@android:color/transparent"
                                app:trackThickness="10dp"
                                app:trackCornerRadius="5dp" />
                            <!-- Progress Arc -->
                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/pb_laporan_fat"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:progress="60"
                                android:rotation="-79"
                                app:indicatorColor="@color/ring_blue"
                                app:indicatorSize="86dp"
                                app:trackColor="@android:color/transparent"
                                app:trackThickness="10dp"
                                app:trackCornerRadius="5dp" />

                            <!-- Small Icon at top -->
                            <ImageView
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_gravity="top|center_horizontal"
                                android:layout_marginTop="2dp"
                                android:src="@drawable/ic_fruit_avocado"
                                android:translationZ="10dp"
                                app:tint="@color/ring_blue" />

                        </FrameLayout>

                        <TextView
                            android:id="@+id/tv_fat_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="-64dp"
                            android:text="40"
                            android:textColor="@color/text_black_bold"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_fat_target"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="/ 65g"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>