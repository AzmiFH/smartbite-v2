<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <!-- Header: Month Navigator -->
        <LinearLayout
            android:id="@+id/ll_month_navigator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/iv_prev_week"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:src="@drawable/ic_chevron_left"
                app:tint="#CCCCCC" />

            <TextView
                android:id="@+id/tv_current_month_range"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="32dp"
                android:text="Jun 14 - Jun 20"
                android:textColor="@color/text_black_bold"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/iv_next_week"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="#CCCCCC" />
        </LinearLayout>

        <!-- Weekly Calendar -->
        <LinearLayout
            android:id="@+id/ll_weekly_calendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="8dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/ll_month_navigator">

            <include layout="@layout/item_calendar_day" android:id="@+id/day_1" />
            <include layout="@layout/item_calendar_day" android:id="@+id/day_2" />
            <include layout="@layout/item_calendar_day" android:id="@+id/day_3" />
            <include layout="@layout/item_calendar_day" android:id="@+id/day_4" />
            <include layout="@layout/item_calendar_day" android:id="@+id/day_5" />
            <include layout="@layout/item_calendar_day" android:id="@+id/day_6" />
            <include layout="@layout/item_calendar_day" android:id="@+id/day_7" />

        </LinearLayout>

        <!-- Main Content Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cv_main_report"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginHorizontal="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white"
            app:layout_constraintTop_toBottomOf="@id/ll_weekly_calendar">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <!-- Activity Rings Section -->
                <FrameLayout
                    android:id="@+id/fl_activity_rings"
                    android:layout_width="230dp"
                    android:layout_height="230dp"
                    android:layout_marginTop="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <!-- Outer Ring (Orange/Red - Protein) -->
                    <!-- Track Arc -->
                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:progress="100"
                        android:rotation="-90"
                        app:indicatorColor="@color/ring_bg_orange"
                        app:indicatorSize="220dp"
                        app:trackColor="@android:color/transparent"
                        app:trackThickness="14dp"
                        app:trackCornerRadius="7dp" />
                    <!-- Progress Arc -->
                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/cp_ring_outer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:progress="0"
                        android:rotation="-90"
                        app:indicatorColor="@color/ring_orange"
                        app:indicatorSize="220dp"
                        app:trackColor="@android:color/transparent"
                        app:trackThickness="14dp"
                        app:trackCornerRadius="7dp" />

                    <!-- Middle Ring (Green - Carbs) -->
                    <!-- Track Arc -->
                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:progress="100"
                        android:rotation="-90"
                        app:indicatorColor="@color/ring_bg_green"
                        app:indicatorSize="178dp"
                        app:trackColor="@android:color/transparent"
                        app:trackThickness="14dp"
                        app:trackCornerRadius="7dp" />
                    <!-- Progress Arc -->
                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/cp_ring_middle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:progress="0"
                        android:rotation="-90"
                        app:indicatorColor="@color/ring_green"
                        app:indicatorSize="178dp"
                        app:trackColor="@android:color/transparent"
                        app:trackThickness="14dp"
                        app:trackCornerRadius="7dp" />

                    <!-- Inner Ring (Blue - Fat) -->
                    <!-- Track Arc -->
                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:progress="100"
                        android:rotation="-90"
                        app:indicatorColor="@color/ring_bg_blue"
                        app:indicatorSize="136dp"
                        app:trackColor="@android:color/transparent"
                        app:trackThickness="14dp"
                        app:trackCornerRadius="7dp" />
                    <!-- Progress Arc -->
                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/cp_ring_inner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:progress="0"
                        android:rotation="-90"
                        app:indicatorColor="@color/ring_blue"
                        app:indicatorSize="136dp"
                        app:trackColor="@android:color/transparent"
                        app:trackThickness="14dp"
                        app:trackCornerRadius="7dp" />

                    <!-- Icons: Aligned with Dashboard -->
                    <!-- Protein (Orange/Red) - Fork/Knife -->
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="5dp"
                        android:src="@drawable/ic_macro_protein"
                        android:translationZ="10dp"
                        app:tint="@color/ring_orange" />

                    <!-- Carbs (Green) - Apple -->
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="26dp"
                        android:src="@drawable/ic_macro_carbs"
                        android:translationZ="10dp"
                        app:tint="@color/ring_green" />

                    <!-- Fat (Blue) - Avocado -->
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="47dp"
                        android:src="@drawable/ic_macro_fat"
                        android:translationZ="10dp"
                        app:tint="@color/ring_blue" />

                    <!-- Center Text -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_consumed_cal_big"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/text_black_bold"
                            android:textSize="32sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_target_cal_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Macros Grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toBottomOf="@id/fl_activity_rings">

                    <!-- Carbs (Green) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="90dp"
                            android:layout_height="90dp">

                            <!-- Track Arc -->
                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:progress="100"
                                android:rotation="-90"
                                app:indicatorColor="@color/ring_bg_green"
                                app:indicatorSize="86dp"
                                app:trackColor="@android:color/transparent"
                                app:trackThickness="10dp"
                                app:trackCornerRadius="5dp" />
                            <!-- Progress Arc -->
                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/pb_laporan_carbs"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:progress="0"
                                android:rotation="-90"
                                app:indicatorColor="@color/ring_green"
                                app:indicatorSize="86dp"
                                app:trackColor="@android:color/transparent"
                                app:trackThickness="10dp"
                                app:trackCornerRadius="5dp" />

                            <!-- Small Icon at top -->
                            <ImageView
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_gravity="top|center_horizontal"
                                android:layout_marginTop="2dp"
                                android:src="@drawable/ic_macro_carbs"
                                android:translationZ="10dp"
                                app:tint="@color/ring_green" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tv_carb_val"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:textColor="@color/text_black_bold"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tv_carb_unit"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="-4dp"
                                    android:text="g"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="10sp" />
                            </LinearLayout>
                        </FrameLayout>
                    </LinearLayout>

                    <!-- Protein (Orange/Red) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="90dp"
                            android:layout_height="90dp">

                            <!-- Track Arc -->
                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:progress="100"
                                android:rotation="-90"
                                app:indicatorColor="@color/ring_bg_orange"
                                app:indicatorSize="86dp"
                                app:trackColor="@android:color/transparent"
                                app:trackThickness="10dp"
                                app:trackCornerRadius="5dp" />
                            <!-- Progress Arc -->
                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/pb_laporan_protein"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:progress="0"
                                android:rotation="-90"
                                app:indicatorColor="@color/ring_orange"
                                app:indicatorSize="86dp"
                                app:trackColor="@android:color/transparent"
                                app:trackThickness="10dp"
                                app:trackCornerRadius="5dp" />

                            <!-- Small Icon at top -->
                            <ImageView
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_gravity="top|center_horizontal"
                                android:layout_marginTop="2dp"
                                android:src="@drawable/ic_macro_protein"
                                android:translationZ="10dp"
                                app:tint="@color/ring_orange" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tv_protein_val"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:textColor="@color/text_black_bold"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tv_protein_unit"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="-4dp"
                                    android:text="g"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="10sp" />
                            </LinearLayout>
                        </FrameLayout>
                    </LinearLayout>

                    <!-- Fat (Blue) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="90dp"
                            android:layout_height="90dp">

                            <!-- Track Arc -->
                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:progress="100"
                                android:rotation="-90"
                                app:indicatorColor="@color/ring_bg_blue"
                                app:indicatorSize="86dp"
                                app:trackColor="@android:color/transparent"
                                app:trackThickness="10dp"
                                app:trackCornerRadius="5dp" />
                            <!-- Progress Arc -->
                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/pb_laporan_fat"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:progress="0"
                                android:rotation="-90"
                                app:indicatorColor="@color/ring_blue"
                                app:indicatorSize="86dp"
                                app:trackColor="@android:color/transparent"
                                app:trackThickness="10dp"
                                app:trackCornerRadius="5dp" />

                            <!-- Small Icon at top -->
                            <ImageView
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_gravity="top|center_horizontal"
                                android:layout_marginTop="2dp"
                                android:src="@drawable/ic_macro_fat"
                                android:translationZ="10dp"
                                app:tint="@color/ring_blue" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tv_fat_val"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:textColor="@color/text_black_bold"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tv_fat_unit"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="-4dp"
                                    android:text="g"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="10sp" />
                            </LinearLayout>
                        </FrameLayout>
                    </LinearLayout>

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

        <!-- Weekly Calories Chart Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cv_calories_chart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white"
            app:layout_constraintTop_toBottomOf="@id/cv_main_report">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tv_chart_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/calories_title"
                    android:textColor="@color/text_black_bold"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:id="@+id/ll_average_cal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end|center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/tv_average_cal_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:gravity="end"
                        tools:text="Rata-rata harian: 49 kkal" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_secondary" />
                </LinearLayout>

                <!-- Chart Area -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_chart_container"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="24dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_chart_title">

                    <!-- Y-Axis Lines and Labels -->
                    <!-- 200 -->
                    <View
                        android:id="@+id/line_200"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:background="#F0F0F0"
                        android:layout_marginEnd="32dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                    <TextView
                        android:id="@+id/tv_y_200"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="200"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        app:layout_constraintBottom_toBottomOf="@id/line_200"
                        app:layout_constraintTop_toTopOf="@id/line_200"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- 160 -->
                    <View
                        android:id="@+id/line_160"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:background="#F0F0F0"
                        android:layout_marginEnd="32dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/line_200"
                        app:layout_constraintBottom_toTopOf="@id/line_120" />
                    <TextView
                        android:id="@+id/tv_y_160"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="160"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        app:layout_constraintBottom_toBottomOf="@id/line_160"
                        app:layout_constraintTop_toTopOf="@id/line_160"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- 120 -->
                    <View
                        android:id="@+id/line_120"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:background="#F0F0F0"
                        android:layout_marginEnd="32dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/line_160"
                        app:layout_constraintBottom_toTopOf="@id/line_80" />
                    <TextView
                        android:id="@+id/tv_y_120"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="120"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        app:layout_constraintBottom_toBottomOf="@id/line_120"
                        app:layout_constraintTop_toTopOf="@id/line_120"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- 80 -->
                    <View
                        android:id="@+id/line_80"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:background="#F0F0F0"
                        android:layout_marginEnd="32dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/line_120"
                        app:layout_constraintBottom_toTopOf="@id/line_40" />
                    <TextView
                        android:id="@+id/tv_y_80"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="80"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        app:layout_constraintBottom_toBottomOf="@id/line_80"
                        app:layout_constraintTop_toTopOf="@id/line_80"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- 40 -->
                    <View
                        android:id="@+id/line_40"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:background="#F0F0F0"
                        android:layout_marginEnd="32dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/line_80"
                        app:layout_constraintBottom_toTopOf="@id/line_0" />
                    <TextView
                        android:id="@+id/tv_y_40"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="40"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        app:layout_constraintBottom_toBottomOf="@id/line_40"
                        app:layout_constraintTop_toTopOf="@id/line_40"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- 0 -->
                    <View
                        android:id="@+id/line_0"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:background="#CCCCCC"
                        android:layout_marginEnd="32dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toTopOf="@id/ll_days_labels" />
                    <TextView
                        android:id="@+id/tv_y_0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        app:layout_constraintBottom_toBottomOf="@id/line_0"
                        app:layout_constraintTop_toTopOf="@id/line_0"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- Bars Container -->
                    <LinearLayout
                        android:id="@+id/ll_bars_container"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:orientation="horizontal"
                        android:layout_marginEnd="32dp"
                        android:gravity="bottom"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="@id/line_0"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <!-- Sen -->
                        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                            <View android:id="@+id/bar_sen" android:layout_width="16dp" android:layout_height="20dp" android:layout_gravity="bottom|center_horizontal" android:background="@drawable/bg_bar_chart" android:backgroundTint="@color/ring_green" />
                        </FrameLayout>
                        <!-- Sel -->
                        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                            <View android:id="@+id/bar_sel" android:layout_width="16dp" android:layout_height="70dp" android:layout_gravity="bottom|center_horizontal" android:background="@drawable/bg_bar_chart" android:backgroundTint="@color/ring_green" />
                        </FrameLayout>
                        <!-- Rab -->
                        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                            <View android:id="@+id/bar_rab" android:layout_width="16dp" android:layout_height="15dp" android:layout_gravity="bottom|center_horizontal" android:background="@drawable/bg_bar_chart" android:backgroundTint="@color/ring_green" />
                        </FrameLayout>
                        <!-- Kam -->
                        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                            <View android:id="@+id/bar_kam" android:layout_width="16dp" android:layout_height="100dp" android:layout_gravity="bottom|center_horizontal" android:background="@drawable/bg_bar_chart" android:backgroundTint="@color/ring_green" />
                        </FrameLayout>
                        <!-- Jum -->
                        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                            <View android:id="@+id/bar_jum" android:layout_width="16dp" android:layout_height="0dp" android:layout_gravity="bottom|center_horizontal" android:background="@drawable/bg_bar_chart" android:backgroundTint="@color/ring_green" />
                        </FrameLayout>
                        <!-- Sab -->
                        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                            <View android:id="@+id/bar_sab" android:layout_width="16dp" android:layout_height="0dp" android:layout_gravity="bottom|center_horizontal" android:background="@drawable/bg_bar_chart" android:backgroundTint="@color/ring_green" />
                        </FrameLayout>
                        <!-- Min -->
                        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                            <View android:id="@+id/bar_min" android:layout_width="16dp" android:layout_height="0dp" android:layout_gravity="bottom|center_horizontal" android:background="@drawable/bg_bar_chart" android:backgroundTint="@color/ring_green" />
                        </FrameLayout>

                    </LinearLayout>

                    <!-- Days Labels -->
                    <LinearLayout
                        android:id="@+id/ll_days_labels"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginEnd="32dp"
                        android:layout_marginTop="8dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/mon" android:gravity="center" android:textSize="12sp" android:textColor="@color/text_secondary" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/tue" android:gravity="center" android:textSize="12sp" android:textColor="@color/text_secondary" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/wed" android:gravity="center" android:textSize="12sp" android:textColor="@color/text_secondary" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/thu" android:gravity="center" android:textSize="12sp" android:textColor="@color/text_secondary" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/fri" android:gravity="center" android:textSize="12sp" android:textColor="@color/text_secondary" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/sat" android:gravity="center" android:textSize="12sp" android:textColor="@color/text_secondary" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/sun" android:gravity="center" android:textSize="12sp" android:textColor="@color/text_secondary" />
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

        <!-- Food History Section -->
        <LinearLayout
            android:id="@+id/ll_food_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginHorizontal="16dp"
            android:orientation="vertical"
            android:visibility="visible"
            app:layout_constraintTop_toBottomOf="@id/cv_calories_chart">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">
                
                <TextView
                    android:id="@+id/tv_history_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/food_history_title"
                    android:textColor="#0B1A30"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:id="@+id/tv_history_see_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lihat Semua"
                    android:textColor="@color/brand_green"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_meal_history" />

            <TextView
                android:id="@+id/tv_history_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/empty_history_today"
                android:textColor="@color/text_secondary"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>