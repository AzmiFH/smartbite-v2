<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="@drawable/bg_daily_progress_card"
    android:elevation="2dp">

    <TextView
        android:id="@+id/tv_weekly_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your Daily Progress"
        android:textColor="@color/text_black_bold"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_more_weekly"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_grid_custom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_weekly_title"
        app:tint="@color/text_subtitle" />

    <LinearLayout
        android:id="@+id/weekly_info_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_weekly_title">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WEEKLY CALORIES"
            android:textColor="@color/text_subtitle"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12,950"
            android:textColor="@color/text_black_bold"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total this week"
            android:textColor="@color/text_subtitle"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Simple Bar Chart Dummy -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_marginStart="16dp"
        android:gravity="bottom"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@+id/weekly_info_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/weekly_info_container"
        app:layout_constraintTop_toTopOf="@+id/weekly_info_container">

        <!-- S -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_horizontal|bottom"
            android:orientation="vertical">
            <View
                android:layout_width="12dp"
                android:layout_height="50dp"
                android:background="@color/brand_green" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="S"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- S -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_horizontal|bottom"
            android:orientation="vertical">
            <View
                android:layout_width="12dp"
                android:layout_height="70dp"
                android:background="@color/brand_green" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="S"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- R -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_horizontal|bottom"
            android:orientation="vertical">
            <View
                android:layout_width="12dp"
                android:layout_height="40dp"
                android:background="@color/brand_green" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="R"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- K -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_horizontal|bottom"
            android:orientation="vertical">
            <View
                android:layout_width="12dp"
                android:layout_height="80dp"
                android:background="@color/brand_green" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="K"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- J -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_horizontal|bottom"
            android:orientation="vertical">
            <View
                android:layout_width="12dp"
                android:layout_height="60dp"
                android:background="@color/brand_green" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="J"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- S (Inactive) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_horizontal|bottom"
            android:orientation="vertical">
            <View
                android:layout_width="12dp"
                android:layout_height="0dp"
                android:background="#E0E0E0" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="S"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- M (Today Placeholder) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_horizontal|bottom"
            android:orientation="vertical">
            <View
                android:layout_width="12dp"
                android:layout_height="30dp"
                android:background="#E0E0E0" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="M"
                android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>