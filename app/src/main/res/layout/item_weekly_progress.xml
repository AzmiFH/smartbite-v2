<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="12dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@color/white"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp">

        <TextView
            android:id="@+id/tv_weekly_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Weekly Progress"
            android:textColor="@color/text_black_bold"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/iv_more_weekly"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_grid_custom"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_weekly_title"
            app:tint="@color/text_subtitle" />

        <LinearLayout
            android:id="@+id/weekly_info_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_weekly_title">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WEEKLY CALORIES"
                android:textColor="@color/text_subtitle"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_total_weekly_cal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/text_black_bold"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total this week"
                android:textColor="@color/text_subtitle"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chart_container"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_marginStart="8dp"
            android:gravity="bottom"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="@+id/weekly_info_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/weekly_info_container"
            app:layout_constraintTop_toTopOf="@+id/weekly_info_container">

            <!-- Senin -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_horizontal|bottom"
                android:orientation="vertical">
                <View
                    android:id="@+id/bar_mon"
                    android:layout_width="10dp"
                    android:layout_height="0dp"
                    android:background="@drawable/bg_bar_chart"
                    android:backgroundTint="@color/brand_green" />
                <TextView
                    android:id="@+id/tv_label_mon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Sen"
                    android:textSize="8sp" />
            </LinearLayout>

            <!-- Selasa -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_horizontal|bottom"
                android:orientation="vertical">
                <View
                    android:id="@+id/bar_tue"
                    android:layout_width="10dp"
                    android:layout_height="0dp"
                    android:background="@drawable/bg_bar_chart"
                    android:backgroundTint="@color/brand_green" />
                <TextView
                    android:id="@+id/tv_label_tue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Sel"
                    android:textSize="8sp" />
            </LinearLayout>

            <!-- Rabu -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_horizontal|bottom"
                android:orientation="vertical">
                <View
                    android:id="@+id/bar_wed"
                    android:layout_width="10dp"
                    android:layout_height="0dp"
                    android:background="@drawable/bg_bar_chart"
                    android:backgroundTint="@color/brand_green" />
                <TextView
                    android:id="@+id/tv_label_wed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Rab"
                    android:textSize="8sp" />
            </LinearLayout>

            <!-- Kamis -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_horizontal|bottom"
                android:orientation="vertical">
                <View
                    android:id="@+id/bar_thu"
                    android:layout_width="10dp"
                    android:layout_height="0dp"
                    android:background="@drawable/bg_bar_chart"
                    android:backgroundTint="@color/brand_green" />
                <TextView
                    android:id="@+id/tv_label_thu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Kam"
                    android:textSize="8sp" />
            </LinearLayout>

            <!-- Jumat -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_horizontal|bottom"
                android:orientation="vertical">
                <View
                    android:id="@+id/bar_fri"
                    android:layout_width="10dp"
                    android:layout_height="0dp"
                    android:background="@drawable/bg_bar_chart"
                    android:backgroundTint="@color/brand_green" />
                <TextView
                    android:id="@+id/tv_label_fri"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Jum"
                    android:textSize="8sp" />
            </LinearLayout>

            <!-- Sabtu -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_horizontal|bottom"
                android:orientation="vertical">
                <View
                    android:id="@+id/bar_sat"
                    android:layout_width="10dp"
                    android:layout_height="0dp"
                    android:background="@drawable/bg_bar_chart"
                    android:backgroundTint="@color/brand_green" />
                <TextView
                    android:id="@+id/tv_label_sat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Sab"
                    android:textSize="8sp" />
            </LinearLayout>

            <!-- Minggu -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_horizontal|bottom"
                android:orientation="vertical">
                <View
                    android:id="@+id/bar_sun"
                    android:layout_width="10dp"
                    android:layout_height="0dp"
                    android:background="@drawable/bg_bar_chart"
                    android:backgroundTint="@color/brand_green" />
                <TextView
                    android:id="@+id/tv_label_sun"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Min"
                    android:textSize="8sp" />
            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>